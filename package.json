{
  "name": "@waelio/sockets",
  "version": "1.0.0",
  "description": "Lightweight, typed native WebSocket client with auto-reconnect, heartbeat, and event routing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waelio/Sockets.git"
  },
  "keywords": [
    "websocket",
    "typescript",
    "waelio",
    "socket",
    "realtime",
    "client"
  ],
  "author": {
    "name": "Wael Wahbeh",
    "email": "wahbehw@gmail.com",
    "url": "https://waelio.com"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/waelio/Sockets/issues"
  },
  "homepage": "https://github.com/waelio/Sockets#readme",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
